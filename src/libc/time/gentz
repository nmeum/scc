#!/bin/sh

cat <<EOF
#include <stdlib.h>
#include <string.h>
#include <time.h>

#include "../libc.h"

`
awk '{
	zones[$1] = 1
	if (length($1) > max)
		max = length($1)
	nr++
}
END {
	printf("#define MAX %d\n", max+1);
	printf("#define NR %d\n", nr);
	print("static char tzones[NR][MAX] = {");
	for (z in zones)
		printf("\t\\"%s\\",\n", z) | "sort"
	close("sort")
	print "};\n"
}' "$@"`

static int
cmp(const void *ps1, const void *ps2)
{
	const char *s1 = ps1, *s2 = ps2;

	return strcmp(s1, s2);
}

char *
_gmtoff(char *tz)
{
	return bsearch(tz, tzones, NR, MAX, cmp);
}
EOF
